# Copy to .env and fill in values. install.sh / update.sh source this file from the repo root.
# Do not commit .env (it is gitignored).

# -----------------------------------------------------------------------------
# Required for install/update (rendered into managed mcporter.json)
# -----------------------------------------------------------------------------

MESSY_VIRGO_MCP_URL=https://api.messyvirgo.com/mcp
MESSY_VIRGO_API_KEY=

# -----------------------------------------------------------------------------
# Optional: install/update/remove destinations (defaults match OpenClaw / messyvirgo-openclaw-client)
# -----------------------------------------------------------------------------

# Host directory for OpenClaw config and pack-managed includes (openclaw.json fragments, etc.).
# Default if unset: $HOME/.openclaw
# OPENCLAW_CONFIG_DIR=$HOME/.openclaw

# Host root where per-agent workspace templates are copied.
# Default if unset: $HOME/OpenClawWorkspaces
# OPENCLAW_WORKSPACES_DIR=$HOME/OpenClawWorkspaces

# Only when the gateway runs inside Docker: host config is bind-mounted at /home/node/.openclaw in
# the container, but generated pack JSON must list paths the gateway sees. Set this to that in-
# container path. Omit for native OpenClaw (defaults to the same value as OPENCLAW_CONFIG_DIR).
# OPENCLAW_RUNTIME_CONFIG_DIR=/home/node/.openclaw
