# Copy to .env and fill in values. install.sh / update.sh source this file from the repo root.
# Do not commit .env (it is gitignored).

# -----------------------------------------------------------------------------
# Optional: Messy Virgo CLI (`mv`) — bearer auth to the HTTP API
# Not required for pack install; set these so agents can run `mv` via the exec tool with env inherited.
# See README.md (Messy Virgo CLI) and the platform repo path docs/runbooks/command-line-interface.md.
# -----------------------------------------------------------------------------

# MV_API_URL=https://api.messyvirgo.com
# MV_API_KEY=mvk_...

# -----------------------------------------------------------------------------
# Optional: install/update/remove destinations (defaults match OpenClaw)
# -----------------------------------------------------------------------------

# Host directory for OpenClaw config and pack-managed includes (openclaw.json fragments, etc.).
# Default if unset: $HOME/.openclaw
# OPENCLAW_CONFIG_DIR=$HOME/.openclaw

# Host root where per-agent workspace templates are copied.
# Default if unset: $HOME/.openclaw/workspaces
# OPENCLAW_WORKSPACES_DIR=$HOME/.openclaw/workspaces
